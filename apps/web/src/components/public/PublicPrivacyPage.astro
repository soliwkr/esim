---
import { env } from 'cloudflare:workers'
import type { PublicRenderMode } from '../../../../../src/public-render-mode'
import { publicIsPreview, publicTrustPath } from '../../../../../src/public-render-mode'
import { resolvePublicConsentConfig } from '../../../../../src/public-consent'
import PublicLayout from '../../layouts/PublicLayout.astro'
import TrustPage from './TrustPage.astro'

interface Props {
  mode: PublicRenderMode
  siteName: string
}

const { mode, siteName } = Astro.props
const preview = publicIsPreview(mode)
const consentResolution = resolvePublicConsentConfig(env)
const consentConfigured = !preview && consentResolution.kind === 'enabled'
---

<PublicLayout
  mode={mode}
  title={preview ? `Privacy preview | ${siteName}` : `Privacy | ${siteName}`}
  description={preview
    ? 'Preview non indicizzabile delle informazioni privacy attuali di Senza Roaming.'
    : 'Informazioni sul trattamento minimale dei dati.'}
  canonicalPath={publicTrustPath(mode, 'privacy')}
  siteName={siteName}
>
  <TrustPage
    mode={mode}
    eyebrow="Privacy"
    title="Raccogliere meno, spiegare meglio."
    lead={preview
      ? 'Questa preview conserva il contenuto essenziale della pagina privacy attuale. Non introduce CMP, analytics o nuovi trattamenti di dati.'
      : consentConfigured
        ? 'La fondazione di consenso è configurata sul sito pubblico. In questo spike iubenda gestisce soltanto banner e preferenze: GTM e GA4 restano assenti.'
        : 'La pagina descrive il trattamento minimale attuale e separa chiaramente ciò che non viene raccolto dagli strumenti ancora da attivare.'}
    current="privacy"
  >
    <section aria-labelledby="privacy-dati">
      <div class="trust-intro-card">
        <p class="trust-card-label">Dati non richiesti</p>
        <h2 id="privacy-dati">Non chiediamo dati bancari, documenti, nomi o indirizzi email.</h2>
        <p>
          Il sito pubblico non richiede questi dati per leggere guide, confronti o pagine sulle destinazioni.
          La fondazione di consenso non modifica il modello editoriale o l’accesso a D1.
        </p>
      </div>
    </section>

    <section aria-labelledby="privacy-redirect">
      <h2 id="privacy-redirect">Cosa registra il redirect verso un provider</h2>
      <p>Il percorso di redirect conserva soltanto le informazioni operative dichiarate dal contratto attuale:</p>
      <ul>
        <li>pagina di origine;</li>
        <li>provider selezionato;</li>
        <li>posizione del pulsante;</li>
        <li>data del click.</li>
      </ul>
      <p>Non vengono salvati indirizzi IP né user agent nel contratto applicativo attuale.</p>
    </section>

    <section id="preferenze-cookie" aria-labelledby="privacy-strumenti">
      <div class="trust-status-card">
        <p class="trust-card-label">Stato attuale</p>
        {consentConfigured ? (
          <>
            <h2 id="privacy-strumenti">iubenda è configurata; GTM e GA4 restano inattivi.</h2>
            <p>
              La CMP viene caricata soltanto sulle pagine pubbliche canoniche e permette di accettare, rifiutare o modificare le preferenze.
              Questo spike non carica Google Tag Manager, Google Analytics, pubblicità o strumenti di affiliazione.
            </p>
          </>
        ) : (
          <>
            <h2 id="privacy-strumenti">CMP, GA4 e GTM non sono ancora attivi.</h2>
            <p>
              Consenso, analytics e Search Console appartengono a una fase separata. Richiedono configurazione,
              documentazione e verifica prima dell’attivazione.
            </p>
          </>
        )}
      </div>
    </section>

    <section aria-labelledby="privacy-confini">
      <h2 id="privacy-confini">Confini di questa pagina</h2>
      <div class="trust-principle-grid">
        <article class="trust-principle"><h3>Nessun analytics nello spike</h3><p>Google Tag Manager e Google Analytics non vengono caricati.</p></article>
        <article class="trust-principle"><h3>Nessun form</h3><p>La pagina non raccoglie dati dell’utente e non invia mutation al backend.</p></article>
        <article class="trust-principle"><h3>{preview ? 'Route non canonica' : 'Informazioni attuali'}</h3><p>{preview ? 'La pagina resta noindex dentro il namespace preview.' : 'La pagina descrive il comportamento tecnico effettivamente configurato.'}</p></article>
        <article class="trust-principle"><h3>Modifica e revoca</h3><p>{consentConfigured ? 'Il footer espone il comando per riaprire le preferenze cookie.' : 'Il comando comparirà soltanto quando la CMP sarà configurata.'}</p></article>
      </div>
    </section>
  </TrustPage>
</PublicLayout>
