---
import type { PageCard } from '../../../../../src/types'
import type { PublicRenderMode } from '../../../../../src/public-render-mode'
import {
  publicHomePath,
  publicIsPreview,
  publicListingPath,
  publicTrustPath,
} from '../../../../../src/public-render-mode'
import { publicHomepageSeo } from '../../../../../src/public-seo'
import PublicPageCardGrid from './PublicPageCardGrid.astro'
import PublicLayout from '../../layouts/PublicLayout.astro'

interface Props {
  mode: PublicRenderMode
  siteName: string
  featured: PageCard[]
  destinations: PageCard[]
}

const { mode, siteName, featured, destinations } = Astro.props
const preview = publicIsPreview(mode)
const canonicalPath = publicHomePath(mode)
const base = Astro.site ?? new URL(Astro.url.origin)
const seo = publicHomepageSeo(siteName, new URL(canonicalPath, base).toString())
const destinationsHref = publicListingPath(mode, 'destination')
const guidesHref = publicListingPath(mode, 'guide')
const comparisonsHref = publicListingPath(mode, 'comparison')
const methodHref = publicTrustPath(mode, 'metodo')
---

<PublicLayout
  mode={mode}
  title={seo.title}
  description={seo.description}
  canonicalPath={canonicalPath}
  siteName={siteName}
  ogType={seo.ogType}
  schema={seo.schema}
  measurement={{ routeClass: 'home', pageType: 'home' }}
>
  {preview && (
    <div class="preview-band" data-public-shell="astro-preview" data-homepage-candidate>
      Preview Astro · non indicizzata · il sito pubblico attuale non cambia
    </div>
  )}

  <div data-homepage-candidate={preview ? true : undefined} data-public-homepage={mode}>
    <section class="public-hero" aria-labelledby="hero-title">
      <div class="public-container hero-grid">
        <div>
          <p class="eyebrow">eSIM da viaggio, senza improvvisare</p>
          <h1 id="hero-title">Scegli la eSIM giusta per il tuo viaggio.</h1>
          <p class="hero-lead">
            Parti dalla destinazione, verifica che il telefono sia compatibile e confronta soltanto i
            criteri che cambiano davvero: durata, dati, hotspot, attivazione e limiti dichiarati.
          </p>
          <div class="hero-actions">
            <a class="public-button" href={destinationsHref}>Scegli la destinazione</a>
            <a class="public-button secondary" href={guidesHref}>Risolvi un dubbio pratico</a>
          </div>
        </div>

        <aside class="decision-card" aria-labelledby="decision-title">
          <p class="card-kicker">Prima della scelta</p>
          <h2 id="decision-title">Quattro domande valgono più di cento offerte.</h2>
          <ol class="decision-list">
            <li><span>1</span><div>Il modello esatto del telefono supporta la eSIM?</div></li>
            <li><span>2</span><div>In quale Paese andrai e per quanti giorni?</div></li>
            <li><span>3</span><div>Quanti dati, hotspot e chiamate ti servono davvero?</div></li>
            <li><span>4</span><div>Quali condizioni e limiti risultano verificati?</div></li>
          </ol>
        </aside>
      </div>
    </section>

    <section class="public-section" aria-labelledby="start-title">
      <div class="public-container">
        <div class="section-heading">
          <div>
            <p class="eyebrow">Da dove iniziare</p>
            <h2 id="start-title">Una strada diversa per ogni domanda.</h2>
          </div>
          <p>
            La homepage orienta. Le risposte complete appartengono alla destinazione, alla guida pratica
            o al confronto corretto, così ogni intento mantiene una sola pagina proprietaria.
          </p>
        </div>

        <div class="route-grid">
          <a class="route-card" href={destinationsHref}>
            <span class="route-index">01 · DOVE VAI</span>
            <h3>Destinazioni</h3>
            <p>Scegli il Paese e raggiungi la guida che possiede condizioni, reti e limiti specifici.</p>
            <span class="route-arrow">Esplora le destinazioni →</span>
          </a>

          <a class="route-card" href={guidesHref}>
            <span class="route-index">02 · COSA DEVI FARE</span>
            <h3>Guide pratiche</h3>
            <p>Compatibilità, installazione, attivazione, consumi e problemi spiegati in percorsi distinti.</p>
            <span class="route-arrow">Leggi le guide →</span>
          </a>

          <a class="route-card" href={comparisonsHref}>
            <span class="route-index">03 · COSA CAMBIA</span>
            <h3>Confronti</h3>
            <p>Valuta provider, piani e limiti con criteri dichiarati, senza una classifica automatica.</p>
            <span class="route-arrow">Vai ai confronti →</span>
          </a>
        </div>
      </div>
    </section>

    <PublicPageCardGrid
      id="featured-guides"
      eyebrow="Dal catalogo pubblicato"
      title="Guide essenziali"
      description="Pagine fondamentali e approfondimenti già pubblicati. Draft e contenuti in review restano esclusi."
      items={featured}
      mode={mode}
    />

    <PublicPageCardGrid
      id="main-destinations"
      eyebrow="Partenze frequenti"
      title="Destinazioni principali"
      description="Guide pubblicate organizzate per Paese, ognuna proprietaria delle condizioni specifiche della destinazione."
      items={destinations}
      mode={mode}
    />

    <section class="public-section method-section" aria-labelledby="method-title">
      <div class="public-container">
        <div class="section-heading">
          <div>
            <p class="eyebrow">Il metodo</p>
            <h2 id="method-title">La pagina arriva dopo le prove.</h2>
          </div>
          <p>
            Un testo può essere chiaro e ancora non essere pubblicabile. Fonti, claim, scadenze e revisione
            restano passaggi distinti.
          </p>
        </div>

        <div class="method-grid">
          <article class="method-step"><span>01</span><h3>Domanda reale</h3><p>Partiamo da un problema o da un intento riconoscibile, non dal bisogno di creare nuove URL.</p></article>
          <article class="method-step"><span>02</span><h3>Fonti datate</h3><p>Prezzo, durata, rete, hotspot e fair use richiedono una fonte identificabile e una data.</p></article>
          <article class="method-step"><span>03</span><h3>Claim separati</h3><p>Ogni fatto viene verificato singolarmente. Un claim insufficiente non alimenta il testo fattuale.</p></article>
          <article class="method-step"><span>04</span><h3>Revisione umana</h3><p>Brief accettato, draft approvato e pagina pubblicata rimangono tre decisioni diverse.</p></article>
        </div>
      </div>
    </section>

    <section class="public-section trust-section" aria-labelledby="trust-title">
      <div class="public-container trust-grid">
        <div class="trust-copy">
          <p class="eyebrow">Trasparenza operativa</p>
          <h2 id="trust-title">Meno promesse. Più stato visibile.</h2>
          <p>
            {preview
              ? 'Questa preview non pubblica contenuti in review, non attiva affiliazioni e resta isolata dalle route canoniche.'
              : 'Il sito pubblica soltanto contenuti che hanno superato i gate editoriali previsti. Le affiliazioni restano disabilitate finché disclosure, misurazione e controlli non sono pronti.'}
          </p>
        </div>

        <ul class="trust-list">
          <li><strong>Nessuna pubblicazione autonoma</strong><span>L’AI può aiutare ricerca e draft, ma non promuove una pagina a pubblicata.</span></li>
          <li><strong>Informazioni con scadenza</strong><span>Le condizioni commerciali vengono trattate come dati verificati in un momento preciso.</span></li>
          <li><strong>Una pagina per ogni intento</strong><span>Homepage e hub distribuiscono; guide e confronti specialistici rispondono.</span></li>
          <li>
            <strong>{preview ? 'Preview isolata' : 'Route pubbliche controllate'}</strong>
            <span>{preview ? 'Canonical, cache e collegamenti restano confinati nel namespace di prova.' : 'Le route pubbliche leggono soltanto il catalogo pubblicato e mantengono separati contenuto, misurazione e monetizzazione.'}</span>
          </li>
        </ul>
      </div>
    </section>

    <section class="final-cta" aria-labelledby="cta-title">
      <div class="public-container cta-panel">
        <div>
          <h2 id="cta-title">Vuoi vedere come controlliamo le informazioni?</h2>
          <p>Il metodo editoriale descrive cosa può diventare un fatto pubblico, cosa resta escluso e perché un draft approvato non equivale a una pagina pubblicata.</p>
        </div>
        <a class="public-button" href={methodHref}>Leggi il metodo</a>
      </div>
    </section>
  </div>
</PublicLayout>
