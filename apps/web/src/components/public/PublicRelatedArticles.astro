---
import type { PublicRenderMode } from '../../../../../src/public-render-mode'
import { publicArticlePath, publicIsPreview } from '../../../../../src/public-render-mode'
import type { PageCard } from '../../../../../src/types'

interface Props {
  mode: PublicRenderMode
  items: PageCard[]
}

const { mode, items } = Astro.props
const preview = publicIsPreview(mode)
---

{items.length > 0 && (
  <aside class="article-related" aria-labelledby="article-related-title" data-related-articles>
    <div class="article-related-heading">
      <p class="eyebrow">Continua dal catalogo</p>
      <h2 id="article-related-title">Guide correlate</h2>
    </div>
    <div class="article-related-grid">
      {items.map((item) => (
        <article>
          <p>{item.cluster}</p>
          <h3><a href={publicArticlePath(mode, item.slug)}>{item.title}</a></h3>
          <span>{item.meta_description}</span>
          <a class="article-related-link" href={publicArticlePath(mode, item.slug)}>{preview ? 'Leggi nella preview' : 'Leggi la guida'} →</a>
        </article>
      ))}
    </div>
  </aside>
)}
