---
import type { PageCard } from '../../../../../src/types'
import type { PublicArticle } from '../../../../../src/public-article'
import type { PublicRenderMode } from '../../../../../src/public-render-mode'
import {
  publicArticlePath,
  publicHomePath,
  publicIsPreview,
  publicListingPath,
} from '../../../../../src/public-render-mode'
import { publicArticleSeo } from '../../../../../src/public-seo'
import PublicLayout from '../../layouts/PublicLayout.astro'
import PublicArticleBlocks from './PublicArticleBlocks.astro'
import PublicArticleFaq from './PublicArticleFaq.astro'
import PublicArticleSources from './PublicArticleSources.astro'
import PublicRelatedArticles from './PublicRelatedArticles.astro'
import '../../styles/public-article.css'

interface Props {
  mode: PublicRenderMode
  article: PublicArticle
  related: PageCard[]
  siteName: string
  affiliateEnabled: boolean
}

const { mode, article, related, siteName, affiliateEnabled } = Astro.props
const preview = publicIsPreview(mode)
const sectionType = article.page_type === 'destination'
  ? 'destination'
  : article.page_type === 'comparison'
    ? 'comparison'
    : 'guide'
const section = {
  label: sectionType === 'destination' ? 'Destinazioni' : sectionType === 'comparison' ? 'Confronti' : 'Guide',
  href: publicListingPath(mode, sectionType),
}
const canonicalPath = publicArticlePath(mode, article.slug)
const base = Astro.site ?? new URL(Astro.url.origin)
const seo = publicArticleSeo(article, new URL(canonicalPath, base).toString(), siteName)
const disclosure = affiliateEnabled
  ? 'Alcuni link possono essere affiliati. Potremmo ricevere una commissione senza costi aggiuntivi per te; la commissione non determina automaticamente la classifica.'
  : 'I link ai provider non sono attualmente remunerati.'
---

<PublicLayout
  mode={mode}
  title={seo.title}
  description={seo.description}
  canonicalPath={canonicalPath}
  siteName={siteName}
  ogType={seo.ogType}
  schema={seo.schema}
  measurement={{ routeClass: 'article', pageType: sectionType, contentSlug: article.slug }}
>
  {preview && (
    <div class="preview-band" data-public-shell="astro-preview" data-public-article={article.slug}>
      Preview Astro · non indicizzata · l’articolo pubblico attuale non cambia
    </div>
  )}

  <article class="public-article" data-public-article={article.slug} data-public-render-mode={mode}>
    <header class="article-hero">
      <div class="public-container article-hero-inner">
        <nav class="article-breadcrumbs" aria-label={preview ? 'Percorso articolo preview' : 'Percorso articolo'}>
          <a href={publicHomePath(mode)}>{preview ? 'Home preview' : 'Home'}</a>
          <span aria-hidden="true">/</span>
          <a href={section.href}>{section.label}</a>
          <span aria-hidden="true">/</span>
          <span aria-current="page">{article.h1}</span>
        </nav>

        <div class="article-meta" aria-label="Metadati articolo">
          <span>{article.cluster}</span>
          <span>Intento: {article.search_intent}</span>
          <span>Stato: published</span>
        </div>

        <p class="eyebrow">{article.eyebrow}</p>
        <h1>{article.h1}</h1>
        <p class="article-intro">{article.intro}</p>
      </div>
    </header>

    <div class="public-container article-layout">
      <div class="article-main-column">
        <section class="article-direct-answer" aria-labelledby="direct-answer-title">
          <p class="article-answer-label" id="direct-answer-title">Risposta diretta</p>
          <p>{article.direct_answer}</p>
        </section>

        <aside class="article-disclosure" aria-label="Trasparenza">
          <strong>Trasparenza.</strong>
          <span>{disclosure} Le condizioni possono cambiare: controlla sempre la fonte prima di scegliere.</span>
        </aside>

        <PublicArticleBlocks blocks={article.content} />
        <PublicArticleFaq items={article.faq} />
      </div>

      <aside class="article-side-note" aria-labelledby="article-side-note-title">
        <p class="article-side-label">{preview ? 'Contratto della preview' : 'Criteri della pagina'}</p>
        <h2 id="article-side-note-title">Solo contenuto già pubblicato.</h2>
        <ul>
          <li>Nessun draft o riga in review.</li>
          <li>Nessun HTML generato viene eseguito.</li>
          <li>Le fonti non diventano test indipendenti.</li>
          <li>{preview ? 'La route canonica resta sul renderer corrente.' : 'Claim e fonti restano soggetti a verifica e aggiornamento.'}</li>
        </ul>
      </aside>
    </div>

    <div class="public-container article-lower-sections">
      <PublicArticleSources
        sources={article.sources}
        sourceCheckedAt={article.source_checked_at}
        updatedAt={article.updated_at}
      />
      <PublicRelatedArticles mode={mode} items={related} />
    </div>
  </article>
</PublicLayout>
