---
import { env } from 'cloudflare:workers'
import PublicFooter from '../components/public/PublicFooter.astro'
import PublicHeader from '../components/public/PublicHeader.astro'
import { setPublicResponseHeaders } from '../lib/public-response'
import type { PublicRenderMode } from '../../../../src/public-render-mode'
import { publicIsPreview } from '../../../../src/public-render-mode'
import type { PublicJsonLdDocument, PublicOpenGraphType } from '../../../../src/public-seo'
import { serializeJsonLd } from '../../../../src/public-seo'
import { iubendaEmbedUrl, resolvePublicConsentConfig } from '../../../../src/public-consent'
import type { PublicMeasurementPageContextInput } from '../../../../src/public-measurement'
import {
  publicMeasurementBootstrapScript,
  resolvePublicMeasurementConfig,
  resolvePublicMeasurementPageContext,
} from '../../../../src/public-measurement'
import '../styles/public.css'

interface Props {
  mode: PublicRenderMode
  title: string
  description: string
  canonicalPath: string
  siteName?: string
  ogType?: PublicOpenGraphType
  schema?: PublicJsonLdDocument | PublicJsonLdDocument[]
  noindex?: boolean
  measurement?: PublicMeasurementPageContextInput
}

const {
  mode,
  title,
  description,
  canonicalPath,
  siteName = 'Senza Roaming',
  ogType = 'website',
  schema,
  noindex: forceNoindex = false,
  measurement,
} = Astro.props

const base = Astro.site ?? new URL(Astro.url.origin)
const canonicalUrl = new URL(canonicalPath, base).toString()
const noindex = forceNoindex || publicIsPreview(mode)
const robots = noindex ? 'noindex,nofollow' : 'index,follow,max-image-preview:large'
const schemaJson = schema ? serializeJsonLd(schema) : null
const consentResolution = noindex
  ? ({ kind: 'disabled' } as const)
  : resolvePublicConsentConfig(env)
const consentConfig = consentResolution.kind === 'enabled' ? consentResolution.config : null
const consentEmbedUrl = consentConfig ? iubendaEmbedUrl(consentConfig) : null
const measurementResolution = noindex || !measurement
  ? ({ kind: 'disabled' } as const)
  : resolvePublicMeasurementConfig(env, consentResolution)
const measurementContextResolution = measurement
  ? resolvePublicMeasurementPageContext(measurement)
  : null
const measurementScript = measurementResolution.kind === 'enabled' && measurementContextResolution?.kind === 'enabled'
  ? publicMeasurementBootstrapScript(measurementResolution.config, measurementContextResolution.context)
  : null

setPublicResponseHeaders(Astro.response.headers, mode, forceNoindex)
---

<!doctype html>
<html lang="it">
  <head>
    {consentEmbedUrl && <script is:inline type="text/javascript" src={consentEmbedUrl}></script>}
    {measurementScript && (
      <script
        is:inline
        type="text/plain"
        class="_iub_cs_activate"
        data-iub-purposes="4"
        set:html={measurementScript}
      ></script>
    )}
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="impact-site-verification" value="b0854989-f32f-4e6f-be5d-ec2599a18ab7" />
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="it_IT" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta name="theme-color" content="#073f43" />
    <title>{title}</title>
    {schemaJson && <script type="application/ld+json" set:html={schemaJson}></script>}
  </head>
  <body>
    <a class="skip-link" href="#contenuto">Vai al contenuto</a>
    <PublicHeader mode={mode} />
    <main id="contenuto" tabindex="-1">
      <slot />
    </main>
    <PublicFooter mode={mode} consentPreferencesEnabled={Boolean(consentConfig)} />
  </body>
</html>
